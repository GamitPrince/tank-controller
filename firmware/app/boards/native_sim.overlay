/*
 * On native_sim the flash log uses the simulated flash's storage partition and
 * the ESP32 link an emulated UART that nothing answers, so records stay
 * logged. The FRDM-MCXN947 overlay (with the EE's pin mapping) points
 * tank,log-partition at the external W25Q64 and tank,esp32-uart at the real
 * UART instead.
 */
/ {
	chosen {
		tank,log-partition = &storage_partition;
		tank,esp32-uart = &esp32_uart;
	};

	esp32_uart: esp32-uart {
		compatible = "zephyr,uart-emul";
		status = "okay";
		current-speed = <115200>;
		rx-fifo-size = <1024>;
		tx-fifo-size = <2048>;
	};
};
